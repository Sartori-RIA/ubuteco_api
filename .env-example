# --- Local Docker Compose (defaults) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost

# --- Production (Railway Postgres plugin) ---
# DATABASE_URL is injected automatically by Railway; no need to set DB_* when present.

MAILER_ADDRESS=127.0.0.1
MAILER_PORT=1025
MAILER_USER_NAME=example@email.com
MAILER_PASSWORD=
MAILER_DOMAIN=localhost
MAILER_HOST=localhost

# Production (Resend): smtp.resend.com, port 587, user resend, password = API key
# MAILER_ADDRESS=smtp.resend.com
# MAILER_PORT=587
# MAILER_SMTP_USER=resend
# MAILER_PASSWORD=re_xxxxxxxx
# MAILER_HOST=app.yourdomain.com

JWT_SECRET=
SESSION_SECRET_TOKEN=
SECRET_KEY_BASE=

# Redis (Sidekiq + AnyCable). Use private REDIS_URL on Railway (not REDIS_PUBLIC_URL).
REDIS_URL=redis://localhost:6379/0

# OpenSearch (Searchkick). Railway template or self-hosted.
OPENSEARCH_URL=http://localhost:9200
# Per-environment index prefix (staging/production)
# SEARCHKICK_INDEX_PREFIX=production
# Required only for bin/rails searchkick:reindex:all
# ALLOW_FULL_SEARCH_REINDEX=1

# Active Storage — S3-compatible (T3, AWS, MinIO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT_URL=https://t3.storageapi.dev
# AWS_S3_FORCE_PATH_STYLE=true

# AnyCable (must match anycable-go service)
ANYCABLE_SECRET=anycable-local-secret
ANYCABLE_HTTP_BROADCAST_URL=http://localhost:8090/_broadcast
ANYCABLE_WEBSOCKET_URL=ws://localhost:8080/api/cable
# Production/staging: comma-separated WebSocket origins (never use * in prod)
# ANYCABLE_ALLOWED_ORIGINS=https://app.example.com
# Use host.docker.internal:50051 when Rails runs on the host (api container stopped).
# Docker Compose sets api → 0.0.0.0:50051 and anycable-ws → api:50051 automatically.
# ANYCABLE_RPC_HOST=host.docker.internal:50051

# CORS (staging/production — required). Comma-separated frontend origins.
# CORS_ORIGINS=http://localhost:3001,https://app.example.com

# Optional: extra hosts for config.hosts (comma-separated)
# ALLOWED_HOSTS=api.yourdomain.com

# Sidekiq worker service on Railway: set SKIP_DB_PREPARE=1 (API runs db:prepare)
